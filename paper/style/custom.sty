\setlength{\epigraphwidth}{0.7\textwidth}

\makeatletter
\renewenvironment{proof}[1][\proofname]{%
  \par\pushQED{\qed}%
  \normalfont
  \topsep6\p@\@plus6\p@\relax
  \trivlist
  \item[\hskip\labelsep\sffamily \ul{#1}.]\ignorespaces
}{%
  \popQED\endtrivlist\@endpefalse
}
\makeatother

