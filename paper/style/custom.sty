\newcommand{\myhrulefill}{\leavevmode\leaders\hrule height .8pt\hfill\kern-.8pt}
\newcommand{\rulediv}[2]{\raisebox{.5ex}{\makebox[\linewidth]{\rule{\dimexpr50pt-#1\relax}{.8pt}\ \raisebox{-.412ex}{\makebox[2\dimexpr#1\relax]{\textsf{\small{#2}}}}\hspace{.7ex}\myhrulefill}}}

\tcbuselibrary{minted,skins}

\newtcblisting{hscode1}[1][]{
    listing engine=minted,
    colback=hscodebg,
    colframe=black!100,
    listing only,
    boxrule=0.8pt,
    minted style=friendly,
    minted language=haskell,
    minted options={linenos=false,numbersep=3.5mm,texcl=true,#1},
    left=5mm,enhanced,
    sharp corners,
    overlay={\begin{tcbclipinterior}\fill[cayenne] (frame.south west)
            rectangle ([xshift=3mm]frame.north west);\end{tcbclipinterior}}
}
\newtcblisting{hscode2}[1][]{
    listing engine=minted,
    colback=hscodebg,
    colframe=black!100,
    listing only,
    boxrule=.9pt,
    minted style=tango,
    minted language=python,
    minted options={linenos=false,numbersep=3.5mm,texcl=true,fontfamily=FiraMono-TLF},
    width=1.28\linewidth,left=5mm,enhanced,#1,
    sharp corners,
    overlay={\begin{tcbclipinterior}\fill[bmidnight] (frame.south west)
            rectangle ([xshift=3mm]frame.north west);\end{tcbclipinterior}}
}
\definecolor{hscodebg}{rgb}{0.98,0.98,0.98}

